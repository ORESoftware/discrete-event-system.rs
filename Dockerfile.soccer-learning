FROM rust:1-bookworm AS builder

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src

RUN cargo build --release --bin main_soccer_learning_run

FROM debian:bookworm-slim

WORKDIR /work
COPY --from=builder /src/target/release/main_soccer_learning_run /usr/local/bin/main_soccer_learning_run

ENV SOCCER_GAMES=100
ENV SOCCER_HALVES=2
ENV SOCCER_HALF_MINUTES=45
ENV SOCCER_PERIOD_BREAK_RECOVERY_SECONDS=900
ENV SOCCER_DT_SECONDS=1.0
ENV SOCCER_LEARNING_INTERVAL_TICKS=4
ENV SOCCER_CHECKPOINT_INTERVAL_GAMES=10
ENV SOCCER_ARTIFACT_MAX_ENTRIES_PER_POLICY=10000
ENV SOCCER_ATTACK_SPACING_DELTA_WEIGHT=0.22
ENV SOCCER_ATTACK_SPACING_SCORE_WEIGHT=0.06
ENV SOCCER_ATTACK_WIDTH_DELTA_WEIGHT=0.52
ENV SOCCER_ATTACK_WIDTH_SCORE_WEIGHT=0.14
ENV SOCCER_ATTACK_FLANK_LANE_WEIGHT=0.28
ENV SOCCER_DEFENSE_SPACING_DELTA_WEIGHT=0.08
ENV SOCCER_DEFENSE_SPACING_SCORE_WEIGHT=0.04
ENV SOCCER_DEFENSE_CONTRACT_DELTA_WEIGHT=0.42
ENV SOCCER_DEFENSE_COMPACTNESS_SCORE_WEIGHT=0.14

ENTRYPOINT ["/usr/local/bin/main_soccer_learning_run"]
